# HTTP 监听端口
PORT=8080

# API / WebSocket 鉴权令牌（生产环境务必设置）
# 请求头: Authorization: Bearer <token>  或  X-API-Token: <token>
# WebSocket: ws://host/ws?token=<token>
API_TOKEN=change-me-to-a-long-random-string

# 仅本地调试：未设置 API_TOKEN 时允许无鉴权访问（切勿用于公网）
# ALLOW_INSECURE_NO_AUTH=true

# 额外允许的 CORS 来源（逗号分隔）。留空=仅同源；* = 任意来源（不推荐）
# CORS_ALLOWED_ORIGINS=https://example.com,http://localhost:3000
